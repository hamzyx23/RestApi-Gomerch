.docs-note.warn { background: var(--nb-yellow) !important; }
.console-fab { background: var(--nb-yellow) !important; color: var(--nb-black) !important; border: 2px solid var(--nb-black) !important; border-radius: 5px !important; box-shadow: 4px 4px 0 var(--nb-black) !important; backdrop-filter: none !important; }
.console-drawer { background: #fffdf5 !important; }
