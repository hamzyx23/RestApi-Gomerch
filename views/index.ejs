    </div>
    <div class="apikey-actions" style="margin-top:12px">
      <button class="btn btn-sm btn-purple-soft" id="btnRegenKey">REGENERATE</button>
      <button class="btn btn-sm btn-danger-soft" id="btnDelKey">HAPUS</button>
    </div>
    ${state.apiKeyStorage === 'local' ? `
      <div class="apikey-warn">
        ⚠️ API key lokal tidak aktif untuk akses eksternal. Setup Upstash Redis untuk mengaktifkan.
      </div>` : ''}
    <div class="apikey-help">
      <strong>Cara pakai:</strong><br>
      • <code>?apikey=${escapeHtml(masked)}</code><br>
      • Header <code>X-API-Key: ${escapeHtml(masked)}</code><br>
      • Header <code>Authorization: Bearer ${escapeHtml(masked)}</code>
    </div>
  `;
  document.getElementById('btnRevealKey').addEventListener('click', () => {
    state.apiKeyRevealed = !state.apiKeyRevealed;
    renderApiKeyFilled();
  });
  document.getElementById('btnCopyKey').addEventListener('click', () => copyText(state.apiKey));
  document.getElementById('btnRegenKey').addEventListener('click', regenerateApiKey);
  document.getElementById('btnDelKey').addEventListener('click', deleteApiKey);
}

async function generateApiKey() {
  const prefixInput = document.getElementById('apikeyPrefix');
  const prefix = (prefixInput?.value || 'GoPay_').trim();
  if (prefix.length < 2 || prefix.length > 20 || !/^[A-Za-z0-9_.-]+$/.test(prefix)) {
    toast('Prefix tidak valid (2-20 char alfanumerik + _ . -)');
    return;
  }

  const btn = document.getElementById('btnGenApiKey');
  if (btn) { btn.disabled = true; btn.innerHTML = '<span class="loading-spinner"></span> Generating…'; }

  const res = await apiJson('POST', '/gopay/apikey', {
    phone: state.phone,
    access_token: state.accessToken,
    refresh_token: state.refreshToken,
    prefix
  });

  if (res.ok && res.data.success) {
    state.apiKey = res.data.apikey;
    state.apiKeyPrefix = res.data.prefix;
    state.apiKeyCreatedAt = res.data.created_at;
    state.apiKeyStorage = 'redis';
    state.apiKeyRevealed = false;
    setApiKeyStorageBadge();
    toast('API key dibuat ☁️');
    renderApiKeyFilled();
    return;
  }

  try {
    const bytes = crypto.getRandomValues(new Uint8Array(24));
    const rand = Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
    const key = prefix + rand;
    const data = {
      key, prefix,
      created_at: new Date().toISOString(),
      access_token: state.accessToken,
      refresh_token: state.refreshToken
    };
    localStorage.setItem(apiKeyStorageKey(), JSON.stringify(data));
    state.apiKey = key;
    state.apiKeyPrefix = prefix;
    state.apiKeyCreatedAt = data.created_at;
    state.apiKeyStorage = 'local';
    state.apiKeyRevealed = false;
    setApiKeyStorageBadge();
    toast('API key dibuat (lokal) 💾');
    renderApiKeyFilled();
  } catch (e) {
    toast('Gagal generate: ' + e.message);
  } finally {
    if (btn) { btn.disabled = false; }
  }
}

async function regenerateApiKey() {
  if (!confirm('Regenerate API key? Key lama akan langsung tidak valid.')) return;
  await apiJson('DELETE', '/gopay/apikey', { phone: state.phone });
  try { localStorage.removeItem(apiKeyStorageKey()); } catch (_) {}
  state.apiKey = null;
  renderApiKeyEmpty();
  await generateApiKey();
}

async function deleteApiKey() {
  if (!confirm('Hapus API key?')) return;
  await apiJson('DELETE', '/gopay/apikey', { phone: state.phone });
  try { localStorage.removeItem(apiKeyStorageKey()); } catch (_) {}
  state.apiKey = null;
  state.apiKeyCreatedAt = null;
  state.apiKeyRevealed = false;
  state.apiKeyStorage = 'none';
  setApiKeyStorageBadge();
  toast('API key dihapus');
  renderApiKeyEmpty();
}

(function initOtpBoxes() {
  const boxes = document.querySelectorAll('#otpBoxes input');
  boxes.forEach((box, i) => {
    box.addEventListener('input', e => {
      const v = e.target.value.replace(/\D/g, '');
      e.target.value = v.slice(-1);
      if (v && i < boxes.length - 1) boxes[i + 1].focus();
    });
    box.addEventListener('keydown', e => {
      if (e.key === 'Backspace' && !box.value && i > 0) boxes[i - 1].focus();
    });
    box.addEventListener('paste', e => {
      e.preventDefault();
      const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 4);
      paste.split('').forEach((ch, j) => { if (boxes[j]) boxes[j].value = ch; });
      if (paste.length) boxes[Math.min(paste.length, boxes.length) - 1].focus();
    });
  });
})();

(function initDrop() {
  const zone = document.getElementById('dropZone');
  if (!zone) return;
  ['dragenter', 'dragover'].forEach(ev => zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.add('dragover'); }));
  ['dragleave', 'drop'].forEach(ev => zone.addEventListener(ev, e => { e.preventDefault(); zone.classList.remove('dragover'); }));
  zone.addEventListener('drop', e => {
    const file = e.dataTransfer?.files?.[0];
    if (file) processQrFile(file);
  });
})();

function docsToggle(el) { el.parentElement.classList.toggle('open'); }
function docsCopy(e) {
  e.stopPropagation();
  const code = e.target.closest('.docs-code');
  const pre = code?.querySelector('pre');
  if (!pre) return;
  navigator.clipboard.writeText(pre.innerText).then(() => {
    const old = e.target.textContent;
    e.target.textContent = 'COPIED ✓';
    e.target.style.color = 'var(--green)';
    setTimeout(() => {
      e.target.textContent = old;
      e.target.style.color = '';
    }, 1400);
  }).catch(() => {});
}

(function initDocs() {
  const el = document.getElementById('docsBaseUrl');
  if (el) el.textContent = location.origin;
  const copyBtn = document.getElementById('btnCopyBaseUrl');
  if (copyBtn) copyBtn.addEventListener('click', () => copyText(location.origin));
  // Buka endpoint pertama di tiap section untuk first impression
  if (window.innerWidth >= 768) {
    document.querySelectorAll('.docs-section .docs-endpoint').forEach((ep, i) => {
      if (i === 0) ep.classList.add('open');
    });
  }
})();

(function restore() {
  try {
    const at = localStorage.getItem('gm_access');
    const rt = localStorage.getItem('gm_refresh');
    const ph = localStorage.getItem('gm_phone');
    if (at) {
      state.accessToken = at;
      state.refreshToken = rt || '';
      state.phone = ph || '';
      renderTokens();
      showScreen('dashboard');
      if (navigator.onLine) {
        api('/gopay/validate', { token: at }).then(res => {
          if (res.status === 401) {
            toast('Session kedaluwarsa, login ulang');
            logout();
          }
        });
      }
    }
  } catch (_) {}
})();

document.getElementById('phoneInput')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') requestOtp();
});

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') toggleNavDrawer(false);
});
window.addEventListener('popstate', () => { const route = (location.hash || '#home').slice(1); if (document.getElementById('screen-' + route)) showScreen(route, { keepScroll: true }); });

</script>
</body>
