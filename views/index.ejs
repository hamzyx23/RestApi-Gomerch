.docs-hero{background:#ffdf45!important;border:2px solid #191919!important;box-shadow:5px 5px 0 #191919!important;border-radius:4px!important}.docs-nav-pill{border:1.5px solid #191919!important;background:#fffdf6!important;color:#171717!important;border-radius:3px!important}.docs-endpoint,.docs-section,.endpoint-card{border:2px solid #191919!important;background:#fffdf6!important;border-radius:4px!important;box-shadow:3px 3px 0 #191919!important}
.console-fab{background:#ffdf45!important;color:#171717!important;border:2px solid #191919!important;border-radius:4px!important;box-shadow:4px 4px 0 #191919!important}.console-drawer{background:#fffdf6!important;border:2px solid #191919!important;border-radius:4px!important;box-shadow:6px 6px 0 #191919!important}
