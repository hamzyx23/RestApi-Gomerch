@media(max-width:520px){.header{min-height:64px;padding:9px 14px}.brand{font-size:17px}.brand-logo{width:38px;height:38px}.badge-connected{font-size:9px;padding:6px 8px}.dashboard-intro{align-items:start;gap:10px}.dashboard-intro h1{font-size:36px}.dashboard-intro p{font-size:13px}.dashboard-intro-stamp{width:58px;height:58px;flex-basis:58px}.dashboard-intro-stamp span{font-size:20px}.dashboard-intro-stamp small{font-size:7px}.token-box{grid-template-columns:minmax(0,1fr);}.token-actions{justify-content:space-between}.token-text{font-size:10px}.panel-title{font-size:21px!important}.panel-card{padding:16px!important}.token-btns{grid-template-columns:1fr 1fr}.docs-header{top:62px}.screen{width:calc(100% - 24px)}#screen-login,#screen-otp{width:calc(100% - 24px)}}
