  document.getElementById('qrisResult').classList.add('show');
  toast('QRIS berhasil dibuat');
  state.historyLoaded = false;
}

async function checkQrisStatus() {
  if (!state.accessToken || !state.qrisAmount || !state.qrisCreatedAt) {
    toast('Generate QRIS dulu');
    return;
  }
  const res = await api('/gopay/qris/status', {
    token: state.accessToken,
    amount: state.qrisAmount,
    created_at: state.qrisCreatedAt
  });
  if (!res.ok || !res.data.success) { toast('Gagal cek status'); return; }
  const st = res.data.status;
  const badge = document.getElementById('qrisStatusBadge');
