function bindQrisUpload() {
  const zone = document.getElementById('qrisUploadZone');
  const input = document.getElementById('qrisUploadInput');
  if (!zone || !input) return;
  zone.addEventListener('click', (e) => { if (e.target !== input) input.click(); });
  zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('dragover'); });
  zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
  zone.addEventListener('drop', async e => {
    e.preventDefault(); zone.classList.remove('dragover');
    const f = e.dataTransfer?.files?.[0];
    if (f) await processQrisUpload(f);
  });
  input.addEventListener('change', async e => {
    const f = e.target.files?.[0];
    if (f) await processQrisUpload(f);
    input.value = '';
  });
}

async function processQrisUpload(file) {
  const zone = document.getElementById('qrisUploadZone');
  zone?.classList.add('loading');
  try {
    toast('Membaca QR…');
    const str = await decodeQrFromFile(file);

    const res = await apiJson('POST', '/gopay/qris/saved', {
      phone: state.phone, static_qr: str
    });

    if (res.ok && res.data.success) {
      state.savedQris = str;
      state.storageMode = 'redis';
      setQrisStorageBadge();
      toast('QRIS tersimpan di cloud ☁️');
      renderQrisUploadFilled(str);
      return;
    }

    try {
      localStorage.setItem(qrisStorageKey(), str);
      state.savedQris = str;
      state.storageMode = 'local';
      setQrisStorageBadge();
      toast('QRIS tersimpan di browser 💾');
      renderQrisUploadFilled(str);
    } catch (e) {
      toast('Gagal simpan QRIS');
    }
  } catch (err) {
    toast(err.message || 'Gagal decode QR');
  } finally {
    zone?.classList.remove('loading');
  }
}

async function deleteQris() {
  if (!confirm('Hapus QRIS tersimpan?')) return;
  await apiJson('DELETE', '/gopay/qris/saved', { phone: state.phone });
  try { localStorage.removeItem(qrisStorageKey()); } catch (_) {}
  state.savedQris = null;
  state.storageMode = 'none';
  setQrisStorageBadge();
  toast('QRIS dihapus');
  renderQrisUploadEmpty();
}

function decodeQrFromFile(file) {
  return new Promise((resolve, reject) => {
    if (!file.type || !file.type.startsWith('image/')) return reject(new Error('File bukan gambar'));
    if (typeof jsQR !== 'function') return reject(new Error('Library jsQR belum termuat'));
    const reader = new FileReader();
    reader.onload = () => {
      const img = new Image();
      img.onload = () => {
        try {
          const MAX = 1200;
          let w = img.width, h = img.height;
          if (w > MAX || h > MAX) {
            const r = Math.min(MAX / w, MAX / h);
            w = Math.round(w * r); h = Math.round(h * r);
          }
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          const ctx = canvas.getContext('2d', { willReadFrequently: true });
          ctx.drawImage(img, 0, 0, w, h);
          const d = ctx.getImageData(0, 0, w, h);
          const code = jsQR(d.data, d.width, d.height, { inversionAttempts: 'attemptBoth' });
          if (code && code.data) resolve(code.data);
          else reject(new Error('QR tidak terdeteksi, coba gambar lebih jelas'));
        } catch (err) { reject(err); }
      };
      img.onerror = () => reject(new Error('Gagal memuat gambar'));
      img.src = reader.result;
    };
    reader.onerror = () => reject(new Error('Gagal membaca file'));
    reader.readAsDataURL(file);
  });
}

async function processQrFile(file) {
  const zone = document.getElementById('dropZone');
  const label = document.getElementById('dropZoneText');
  const originalText = label.textContent;
  zone.classList.add('loading');
  label.textContent = 'MEMBACA QR…';
  try {
