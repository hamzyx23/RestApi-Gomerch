function renderQrImage(qrString) {
  const img = document.getElementById('savedQrisImg');
  if (!img) return;
  const encoded = encodeURIComponent(qrString);
  img.src = `https://api.qrserver.com/v1/create-qr-code/?size=440x440&margin=10&data=${encoded}`;
  img.onerror = () => {
    img.style.display = 'none';
    const note = document.createElement('div');
    note.textContent = 'Preview gagal dimuat';
    note.style.cssText = 'color:#8b9aab;font-size:11px;text-align:center;padding:20px';
    img.parentNode.appendChild(note);
  };
