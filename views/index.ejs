/* =========================================================
   GOMERCHPRO / WORKSPACE V3 — structural responsive redesign
   SVG-first iconography, no glassmorphism, no emoji icons.
   Existing IDs and event handlers intentionally preserved.
   ========================================================= */
:root{
 --bg:#f4f0e5;--glass:#fffdf6;--glass-border:#191919;--glass-border2:#191919;
 --text:#171717;--muted:#68665f;--green:#70e6a5;--green2:#31b979;--green-glow:transparent;
 --purple:#ffdf45;--blue:#9bc8ff;--red:#ff8585;--orange:#ffb66b;--radius:5px;--radius-sm:4px;
 --shadow:5px 5px 0 #171717;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;overflow-x:hidden}
body:before{display:none!important}body:after{background-image:linear-gradient(#1717170b 1px,transparent 1px),linear-gradient(90deg,#1717170b 1px,transparent 1px);background-size:24px 24px;mask-image:none;opacity:.4}
.glass,.glass-strong{background:var(--glass)!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;border:2px solid #191919!important;border-radius:5px!important;box-shadow:5px 5px 0 #191919!important}
.app{width:100%;max-width:none!important;min-height:100dvh;margin:0;padding:0 0 36px;display:block}
.header{position:sticky;top:0;z-index:80;margin:0;padding:12px clamp(16px,3vw,44px);min-height:72px;background:#f4f0e5!important;border-bottom:2px solid #191919;backdrop-filter:none!important;-webkit-backdrop-filter:none!important}
.brand{gap:12px;font-size:19px;letter-spacing:-.06em}.brand-logo{width:44px;height:44px;border:2px solid #191919;border-radius:5px;background:#ffdf45;box-shadow:4px 4px 0 #191919}.brand-logo svg{width:22px;height:22px}.brand span em{color:#287d55}
.badge-connected{border:2px solid #191919;border-radius:4px;color:#171717;background:#70e6a5;padding:7px 12px;box-shadow:3px 3px 0 #191919}.badge-connected .dot{box-shadow:none}
.icon-btn,.copy-btn{border:2px solid #191919!important;border-radius:5px!important;background:#fffdf6!important;color:#171717!important;box-shadow:3px 3px 0 #191919;min-width:40px;min-height:40px}
.screen{width:min(100% - 36px,1440px);margin:28px auto 0;animation:workspace-enter .24s ease both}
#screen-login,#screen-otp{width:min(100% - 32px,560px);margin:clamp(28px,8vh,90px) auto}
.auth-card{padding:clamp(22px,4vw,42px)!important}
.dashboard-intro{display:flex;align-items:end;justify-content:space-between;gap:24px;padding:clamp(22px,4vw,48px);margin:0 0 24px;background:#ffdf45;border:2px solid #191919;box-shadow:6px 6px 0 #191919;min-height:210px}
.dashboard-intro-copy{max-width:760px}.dashboard-kicker{font-size:11px;font-weight:800;letter-spacing:.14em;color:#37342b}.dashboard-intro h1{font-size:clamp(34px,5vw,68px);line-height:.98;letter-spacing:-.075em;margin:14px 0}.dashboard-intro h1 span{color:#287d55}.dashboard-intro p{font-size:clamp(14px,1.5vw,18px);max-width:520px;color:#34332c}.dashboard-intro-stamp{width:110px;height:110px;flex:0 0 110px;border:2px solid #191919;background:#fffdf6;box-shadow:4px 4px 0 #191919;display:grid;place-content:center;text-align:center;transform:rotate(3deg)}.dashboard-intro-stamp span{font-size:34px;font-weight:900;letter-spacing:-.1em}.dashboard-intro-stamp small{font-size:9px;font-weight:800;letter-spacing:.1em}
/* Credentials become a compact security workspace instead of the page's main focus. */
.token-card{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding:18px!important;margin:0 0 24px!important;box-shadow:4px 4px 0 #191919!important}
.token-block{min-width:0}.token-label{font-size:10px!important;font-weight:800;letter-spacing:.13em;text-transform:uppercase;margin-bottom:7px}.token-box{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;padding:10px;background:#f4f0e5;border:1.5px solid #191919;border-radius:4px}.token-text{font:11px/1.5 'JetBrains Mono',monospace;overflow-wrap:anywhere;min-width:0;color:#68665f}.token-actions{display:flex;align-items:center;gap:6px}.token-toggle{border:1.5px solid #191919!important;border-radius:3px!important;background:#fffdf6!important;color:#171717!important;font-size:9px!important;font-weight:800;box-shadow:2px 2px 0 #191919}.token-status{grid-column:1/-1;border:1.5px solid #191919;background:#70e6a5;color:#171717;border-radius:3px;padding:8px 10px;font-size:12px;font-weight:700}.token-status .dot{background:#171717;box-shadow:none}.token-btns{grid-column:1/-1;display:flex;gap:10px}.token-btns .btn{flex:1}
.btn,.menu-tab,.token-toggle,.docs-nav-pill,.copy-url{border-radius:4px!important;transition:transform .14s ease,box-shadow .14s ease,background-color .14s ease!important}
.btn{border:2px solid #191919!important;box-shadow:3px 3px 0 #191919!important;font-weight:800!important;min-height:44px}.btn-primary,.btn-purple,.btn-purple-soft{background:#ffdf45!important;color:#171717!important}.btn-outline,.btn-ghost{background:#fffdf6!important;color:#171717!important;border-color:#191919!important}.btn-danger-soft{background:#ff8585!important;color:#171717!important}.btn:hover,.menu-tab:hover{transform:translate(-1px,-1px);box-shadow:4px 4px 0 #191919!important}.btn:active,.menu-tab:active{transform:translate(3px,3px);box-shadow:0 0 0 #191919!important}
/* Desktop app shell: fixed left navigation, broad working canvas. */
.menu-tabs{position:fixed;z-index:75;left:20px;top:50%;transform:translateY(-50%);width:76px;display:flex;flex-direction:column;gap:10px;padding:10px;background:#fffdf6;border:2px solid #191919;box-shadow:4px 4px 0 #191919;border-radius:5px}
.menu-tab{width:100%;min-height:68px;padding:9px 5px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:7px;border:1.5px solid #191919!important;background:#fffdf6!important;color:#171717!important;font-size:10px;font-weight:800;box-shadow:2px 2px 0 #191919!important}.menu-tab svg{width:22px;height:22px;stroke-width:2}.menu-tab.active{background:#ffdf45!important}
#screen-dashboard{width:min(100% - 190px,1320px);margin:28px 34px 0 max(150px,calc((100vw - 1440px)/2 + 120px))}
#screen-dashboard .dashboard-intro{grid-column:1/-1}
#screen-dashboard .token-card{grid-column:1/-1}
#screen-dashboard{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.72fr);align-items:start;gap:0 24px}
