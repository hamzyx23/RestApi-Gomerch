<div class="toast" id="toast"></div>

<script>
const state = {
  phone: '',
  otpToken: '',
  accessToken: '',
  refreshToken: '',
  qrisCreatedAt: null,
  qrisAmount: null,
  accessExpanded: false,
  refreshExpanded: false,
  logs: [],
  historyLoaded: false,
  payoutsLoaded: false,
  profileLoaded: false,
  savedQris: null,
  storageMode: 'none',
  apiKey: null,
  apiKeyPrefix: 'GoPay_',
  apiKeyCreatedAt: null,
  apiKeyStorage: 'none',
  apiKeyRevealed: false
};

(function detectLowEnd() {
  try {
    const cores = navigator.hardwareConcurrency || 4;
    const mem = navigator.deviceMemory || 4;
    if (cores <= 4 || mem <= 2) document.documentElement.classList.add('reduced');
  } catch (_) {}
})();

function toast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(window._toastT);
  window._toastT = setTimeout(() => el.classList.remove('show'), 2200);
}
function showError(id, msg) {
  const el = document.getElementById(id);
  el.textContent = typeof msg === 'object' ? JSON.stringify(msg) : String(msg);
  el.classList.add('show');
}
function hideError(id) { document.getElementById(id)?.classList.remove('show'); }

let currentScreen = 'home';
function toggleNavDrawer(open) {
  const drawer = document.getElementById('navDrawer');
  const backdrop = document.getElementById('navBackdrop');
  if (!drawer || !backdrop) return;
  drawer.classList.toggle('open', !!open);
  backdrop.classList.toggle('open', !!open);
  drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
  document.body.classList.toggle('drawer-open', !!open);
  if (open) drawer.querySelector('.drawer-link')?.focus({ preventScroll: true });
}
function navigateTo(target) {
  if (['qris','history','payouts'].includes(target)) {
    if (!state.accessToken) { showScreen('login'); toast('Login terlebih dahulu untuk membuka workspace'); return; }
    showScreen('dashboard');
    switchTab(target);
  } else if (['dashboard','profile'].includes(target) && !state.accessToken) {
    showScreen('login'); toast('Login terlebih dahulu untuk membuka workspace');
  } else showScreen(target);
  toggleNavDrawer(false);
}
function showScreen(name, options = {}) {
  const target = document.getElementById('screen-' + name);
  if (!target) return;
  const previous = document.querySelector('.screen.active');
  if (previous && previous !== target) {
    previous.classList.remove('active','leaving');
  }
  document.querySelectorAll('.screen').forEach(s => { if (s !== target) s.classList.remove('active','leaving'); });
  target.classList.add('active');
  currentScreen = name;
  const app = document.getElementById('appRoot');
  const connected = !!state.accessToken && ['dashboard','profile','docs'].includes(name);
  const wideMode = ['home','dashboard','docs','profile'].includes(name);
  app.classList.toggle('docs-mode', wideMode);
  const badge = document.getElementById('headerBadge');
  const profileBtn = document.getElementById('profileTopBtn');
  if (badge) badge.style.display = connected ? 'flex' : 'none';
  if (profileBtn) profileBtn.style.display = connected ? 'grid' : 'none';
  const consoleFab = document.getElementById('consoleFab');
  if (consoleFab) consoleFab.style.display = connected && name === 'dashboard' ? '' : 'none';
  document.querySelectorAll('.drawer-link[data-screen]').forEach(el => el.classList.toggle('active', el.dataset.screen === name || (name === 'dashboard' && ['qris','history','payouts'].includes(state.activeTab) && el.dataset.screen === state.activeTab)));
  if (!connected || name !== 'dashboard') toggleConsole(false);
  if (!options.keepScroll) window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  if (name === 'profile') loadProfile();
  if (name === 'dashboard') updateDashboardMetrics();
  if (name === 'home' || name === 'login' || name === 'otp') toggleNavDrawer(false);
  try { history.replaceState({ screen: name }, '', name === 'home' ? '/' : ('/#' + name)); } catch (_) {}
}
function updateDashboardMetrics() {
  const session = document.getElementById('metricSession');
  if (session) session.textContent = state.accessToken ? 'Connected' : 'Offline';
  const count = document.getElementById('metricTransactions');
  if (count) count.textContent = 'Open history';
}

function maskToken(t) {
  if (!t) return '—';
  if (t.length <= 40) return t;
  return t.slice(0, 36) + '…' + t.slice(-12);
}
function renderTokens() {
  const at = document.getElementById('accessTokenText');
  const rt = document.getElementById('refreshTokenText');
  at.textContent = state.accessExpanded ? (state.accessToken || '—') : maskToken(state.accessToken);
  rt.textContent = state.refreshExpanded ? (state.refreshToken || '—') : maskToken(state.refreshToken);
  at.classList.toggle('expanded', state.accessExpanded);
  rt.classList.toggle('expanded', state.refreshExpanded);
  document.getElementById('accessToggleLabel').textContent = state.accessExpanded ? 'SEMBUNYIKAN' : 'TAMPILKAN';
  document.getElementById('refreshToggleLabel').textContent = state.refreshExpanded ? 'SEMBUNYIKAN' : 'TAMPILKAN';
}
function toggleToken(which) {
  if (which === 'access') state.accessExpanded = !state.accessExpanded;
  else state.refreshExpanded = !state.refreshExpanded;
  renderTokens();
}
async function copyText(t) {
  if (!t) return toast('Kosong');
  try {
    await navigator.clipboard.writeText(t);
    toast('Copied to clipboard');
  } catch { toast('Gagal menyalin'); }
}
function formatRupiah(n) {
  if (n == null || isNaN(Number(n))) return 'Rp 0';
  return 'Rp ' + Number(n).toLocaleString('id-ID');
}
function formatTime(iso) {
  try {
    const d = new Date(iso);
    return d.toLocaleString('id-ID', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  } catch { return iso; }
}
function escapeHtml(s) {
  if (s == null) return '';
  return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function maskApiKey(key) {
  if (!key) return '';
  if (key.length <= 16) return key;
  return key.slice(0, 10) + '…' + key.slice(-6);
}

function addLog(method, path, status, data) {
  const time = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  state.logs.unshift({ time, method, path, status, data });
  if (state.logs.length > 30) state.logs.pop();
  renderConsole();
}
function renderConsole() {
  const body = document.getElementById('consoleBody');
  if (!state.logs.length) {
    body.innerHTML = '<div class="console-empty">Belum ada request</div>';
    return;
  }
  body.innerHTML = state.logs.map((l, i) => `
    <div class="console-item">
      <div style="flex:1">
        <div><span class="time">${l.time}</span> &nbsp; <span class="method">${l.method}</span> ${l.path}</div>
        <button class="copy-json" onclick="copyText(JSON.stringify(state.logs[${i}].data,null,2))">Copy JSON</button>
      </div>
      <span class="status-code ${l.status >= 400 ? 'err' : ''}">${l.status}</span>
    </div>
  `).join('');
}
function clearConsole() { state.logs = []; renderConsole(); }
function toggleConsole(force) {
  const d = document.getElementById('consoleDrawer');
  if (typeof force === 'boolean') d.classList.toggle('open', force);
  else d.classList.toggle('open');
}
document.addEventListener('click', (e) => {
  const d = document.getElementById('consoleDrawer');
  const f = document.getElementById('consoleFab');
  if (!d.classList.contains('open')) return;
  if (d.contains(e.target) || f.contains(e.target)) return;
  d.classList.remove('open');
}, true);

async function api(path, params = {}) {
  const u = new URL(path, location.origin);
  Object.entries(params).forEach(([k, v]) => {
    if (v !== undefined && v !== null && v !== '') u.searchParams.set(k, v);
  });
  try {
    const r = await fetch(u);
    const text = await r.text();
    let data;
    try { data = JSON.parse(text); } catch { data = { raw: text }; }
    addLog('GET', path, r.status, data);
    return { ok: r.ok, status: r.status, data };
  } catch (e) {
    addLog('GET', path, 0, { error: e.message });
    return { ok: false, status: 0, data: { success: false, error: e.message } };
  }
}
async function apiJson(method, path, body) {
  try {
    const r = await fetch(path, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined
    });
    const text = await r.text();
    let data;
    try { data = JSON.parse(text); } catch { data = { raw: text }; }
    addLog(method, path, r.status, data);
    return { ok: r.ok, status: r.status, data };
  } catch (e) {
    addLog(method, path, 0, { error: e.message });
    return { ok: false, status: 0, data: { success: false, error: e.message } };
  }
}

async function refreshAll() {
  const btn = document.getElementById('btnRefresh');
  btn.classList.add('spinning');
  try {
    if (state.accessToken) {
      const v = await api('/gopay/validate', { token: state.accessToken });
      if (v.status === 401) { logout(); return; }
    }
    state.historyLoaded = false;
    state.payoutsLoaded = false;
    state.profileLoaded = false;

    const profileScreen = document.getElementById('screen-profile');
    if (profileScreen && profileScreen.classList.contains('active')) {
      await loadProfile();
    } else {
      const activeTab = document.querySelector('.menu-tab.active')?.dataset.tab;
      if (activeTab === 'payouts') await loadPayouts();
      else if (activeTab === 'qris') await renderQrisPanel();
      else await loadHistory();
    }
    toast('Refreshed ✅');
  } finally {
    setTimeout(() => btn.classList.remove('spinning'), 400);
  }
}

async function requestOtp() {
  hideError('loginError');
  let phone = document.getElementById('phoneInput').value.trim().replace(/\D/g, '');
  if (phone.startsWith('62')) phone = phone.slice(2);
  if (phone.startsWith('0')) phone = phone.slice(1);
  if (!phone || phone.length < 9) {
    showError('loginError', 'Masukkan nomor HP yang valid');
    return;
  }
  const btn = document.getElementById('btnLogin');
  btn.disabled = true;
  btn.innerHTML = '<span class="loading-spinner"></span> Mengirim OTP…';

  const res = await api('/gopay/otp', { phone });
  btn.disabled = false;
  btn.innerHTML = 'Lanjutkan <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';

  if (!res.ok || !res.data.success) {
    const err = res.data.error;
    showError('loginError', typeof err === 'object' ? (err.message || JSON.stringify(err)) : (err || 'Gagal mengirim OTP'));
    return;
  }
  state.phone = phone;
  state.otpToken = res.data.data?.otp_token || '';
  document.getElementById('otpPhoneDisplay').textContent = '+62' + phone;
  document.querySelectorAll('#otpBoxes input').forEach(i => i.value = '');
  showScreen('otp');
  document.querySelector('#otpBoxes input')?.focus();
}

async function verifyOtp() {
  hideError('otpError');
  const digits = [...document.querySelectorAll('#otpBoxes input')].map(i => i.value).join('');
  if (!/^\d{4}$/.test(digits)) {
    showError('otpError', 'Masukkan kode OTP 4 digit');
    return;
  }
  const btn = document.getElementById('btnVerify');
  btn.disabled = true;
  btn.innerHTML = '<span class="loading-spinner" style="border-top-color:#fff"></span> Memverifikasi…';

  const res = await api('/gopay/token', { otp: digits, otp_token: state.otpToken });
  btn.disabled = false;
  btn.textContent = 'Verifikasi';

  if (!res.ok || !res.data.success) {
    const err = res.data.error;
    showError('otpError', typeof err === 'object' ? (err.message || JSON.stringify(err)) : (err || 'OTP salah atau kedaluwarsa'));
    return;
  }
  const d = res.data.data || res.data;
  state.accessToken = d.access_token || d.data?.access_token || '';
  state.refreshToken = d.refresh_token || d.data?.refresh_token || '';

  try {
    localStorage.setItem('gm_access', state.accessToken);
    localStorage.setItem('gm_refresh', state.refreshToken);
    localStorage.setItem('gm_phone', state.phone);
  } catch (_) {}

  renderTokens();
  showScreen('dashboard');
  toast('Login berhasil');
  state.historyLoaded = false;
  state.profileLoaded = false;
  state.savedQris = null;
  state.apiKey = null;
  state.apiKeyStorage = 'none';
  loadHistory();
}

function logout() {
  state.accessToken = '';
  state.refreshToken = '';
  state.otpToken = '';
  state.historyLoaded = false;
  state.payoutsLoaded = false;
  state.profileLoaded = false;
  state.savedQris = null;
  state.storageMode = 'none';
  state.apiKey = null;
  state.apiKeyStorage = 'none';
  state.apiKeyRevealed = false;
  try {
    localStorage.removeItem('gm_access');
    localStorage.removeItem('gm_refresh');
    localStorage.removeItem('gm_phone');
  } catch (_) {}
  showScreen('login');
  toast('Logged out');
}

async function switchTab(tab) {
  document.querySelectorAll('.menu-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.getElementById('panel-' + tab)?.classList.add('active');
  if (tab === 'history' && !state.historyLoaded) loadHistory();
  if (tab === 'payouts' && !state.payoutsLoaded) loadPayouts();
  if (tab === 'qris') await renderQrisPanel();
}

async function ensureSavedQrisLoaded() {
  if (state.savedQris) return state.savedQris;
  if (!state.phone) return null;

  const res = await api('/gopay/qris/saved', { phone: state.phone });
  if (res.ok && res.data.success && res.data.static_qr) {
    state.savedQris = res.data.static_qr;
    state.storageMode = 'redis';
    return state.savedQris;
  }
  try {
    const local = localStorage.getItem('gm_qris_' + state.phone);
    if (local) {
      state.savedQris = local;
      state.storageMode = 'local';
      return state.savedQris;
    }
  } catch (_) {}
  return null;
}

async function renderQrisPanel() {
  await ensureSavedQrisLoaded();

  const hasQris = !!state.savedQris;
  const activeCard = document.getElementById('qrisActiveCard');
  const manualSection = document.getElementById('qrisManualSection');

  if (hasQris) {
    manualSection.style.display = 'none';
    activeCard.style.display = 'block';
    const tail = state.savedQris.slice(-8);
    activeCard.innerHTML = `
      <div class="qris-active-row">
        <div class="qris-active-icon">✓</div>
        <div style="flex:1;min-width:0">
          <div style="font-weight:700;font-size:13px">QRIS Aktif</div>
          <div style="font-size:11px;color:var(--muted);font-family:ui-monospace,monospace;word-break:break-all">•••${escapeHtml(tail)}</div>
        </div>
      </div>
