/* Workspace */
#screen-dashboard{gap:20px;padding-top:clamp(24px,4vw,48px)}.dashboard-intro{border:2px solid var(--ink)!important;border-radius:8px!important;box-shadow:7px 7px 0 var(--ink)!important;background:var(--yellow)!important;color:var(--ink)!important;padding:clamp(24px,4vw,48px)!important;min-height:210px!important}.dashboard-intro h1{font-size:clamp(42px,6vw,76px)!important;letter-spacing:-.075em!important}.dashboard-intro h1 span{color:#3159e8!important}.dashboard-intro p{color:#39372f!important}.dashboard-intro-stamp{background:#fffdf6!important;border:2px solid var(--ink)!important;box-shadow:4px 4px 0 var(--ink)!important;border-radius:6px!important}.dashboard-intro-stamp span{color:var(--ink)!important}.dashboard-intro-stamp small{color:#555!important}.analytics-overview{display:flex;flex-direction:column;gap:16px}.analytics-heading{display:flex;align-items:end;justify-content:space-between;gap:16px}.analytics-heading h2{font-size:clamp(28px,3.4vw,42px);letter-spacing:-.065em;margin-top:6px}.heading-period{color:#3159e8}.analytics-live{display:flex;align-items:center;gap:7px;font-size:9px;font-weight:850;letter-spacing:.1em;border:1.5px solid var(--ink);background:var(--paper);padding:8px 10px}.analytics-live span{width:7px;height:7px;border-radius:50%;background:#43c87b;border:1px solid var(--ink)}.analytics-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.metric-card{border:2px solid var(--ink);background:var(--paper);box-shadow:4px 4px 0 var(--ink);padding:18px;min-width:0}.metric-primary{background:#c5d8ff}.metric-top{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:11px;font-weight:750;color:#555}.metric-top svg{width:23px;height:23px;fill:none;stroke:var(--ink);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.metric-card strong{display:block;font-size:clamp(22px,3vw,34px);letter-spacing:-.06em;margin:18px 0 5px}.metric-card small{font-size:10px;color:#65625a;line-height:1.5}.activity-chart-card{border:2px solid var(--ink);background:var(--paper);box-shadow:4px 4px 0 var(--ink);padding:clamp(16px,2.5vw,26px)}.chart-head{display:flex;justify-content:space-between;align-items:end;gap:12px}.chart-head h3{font-size:20px;letter-spacing:-.04em;margin-top:7px}.chart-note{font-size:10px;color:#69665e}.chart-plot{height:180px;display:grid;grid-template-columns:40px minmax(0,1fr);gap:10px;margin-top:20px}.chart-y-labels{display:flex;flex-direction:column;justify-content:space-between;font-size:9px;color:#777}.chart-plot>svg{width:100%;height:100%;overflow:visible}.chart-grid-lines{stroke:#dcd8cd;stroke-width:1;stroke-dasharray:3 5;fill:none}.chart-area{fill:#c5d8ff;opacity:.8}.chart-line{fill:none;stroke:#3159e8;stroke-width:3;stroke-linecap:round}.chart-point{fill:var(--yellow);stroke:var(--ink);stroke-width:2}.chart-foot{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #dedace;padding-top:12px;margin-top:10px;font-size:9px;color:#777}.token-card,.panel-card,.glass,.glass-strong{background:var(--paper)!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;border:2px solid var(--ink)!important;border-radius:7px!important;box-shadow:5px 5px 0 var(--ink)!important;color:var(--ink)!important}.token-text{background:#f1eee4!important;color:#57554e!important;border:1.5px solid var(--ink)!important}.token-status{background:#a4efbd!important;color:var(--ink)!important;border:1.5px solid var(--ink)!important}.menu-tabs{position:fixed!important;z-index:80;left:50%!important;right:auto!important;bottom:max(20px,env(safe-area-inset-bottom))!important;top:auto!important;transform:translateX(-50%)!important;width:max-content!important;max-width:calc(100vw - 32px)!important;display:flex!important;gap:5px!important;padding:7px!important;border:2px solid var(--ink)!important;border-radius:18px!important;background:rgba(255,253,246,.96)!important;box-shadow:5px 5px 0 var(--ink)!important;backdrop-filter:blur(16px)!important}.menu-tab{display:flex!important;align-items:center;justify-content:center;gap:8px;min-height:46px!important;min-width:112px;padding:0 16px!important;border:1.5px solid transparent!important;border-radius:11px!important;background:transparent!important;color:#57554e!important;font-size:11px!important;font-weight:850!important;letter-spacing:.02em;transition:background .2s,transform .2s!important}.menu-tab svg{width:19px!important;height:19px!important;stroke:currentColor!important}.menu-tab.active{background:var(--yellow)!important;color:var(--ink)!important;border:1.5px solid var(--ink)!important;box-shadow:2px 2px 0 var(--ink)!important;transform:translateY(-2px)}.panel{animation:panel-enter .24s ease both}@keyframes panel-enter{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
/* Navigation drawer */
.nav-backdrop{position:fixed;inset:0;background:rgba(23,23,23,.42);z-index:100;opacity:0;visibility:hidden;transition:opacity .24s,visibility .24s;backdrop-filter:blur(3px)}.nav-backdrop.open{opacity:1;visibility:visible}.nav-drawer{position:fixed;inset:0 auto 0 0;width:min(360px,88vw);z-index:101;background:var(--paper);border-right:2px solid var(--ink);box-shadow:8px 0 0 rgba(23,23,23,.14);padding:26px 20px 18px;display:flex;flex-direction:column;overflow-y:auto;transform:translateX(-105%);transition:transform .3s cubic-bezier(.2,.8,.2,1);visibility:hidden}.nav-drawer.open{transform:translateX(0);visibility:visible}.drawer-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:26px;border-bottom:2px solid var(--ink);margin-bottom:20px}.drawer-head h2{font-size:35px;letter-spacing:-.07em;margin-top:7px}.drawer-section-label{font-size:9px;font-weight:900;letter-spacing:.16em;color:#7b786f;margin:18px 0 8px}.drawer-link{width:100%;display:flex;align-items:center;gap:13px;padding:13px 12px;margin:3px 0;text-align:left;border:1.5px solid transparent;border-radius:5px;background:transparent;color:var(--ink);font:700 13px inherit;cursor:pointer;transition:background .18s,transform .18s,border-color .18s}.drawer-link>svg{width:20px;height:20px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.drawer-link:hover,.drawer-link.active{background:var(--yellow);border-color:var(--ink);transform:translateX(3px)}.drawer-arrow{margin-left:auto}.drawer-logout{color:#a12e2e;margin-top:auto}.drawer-foot{display:flex;align-items:center;gap:10px;border-top:1px solid #d9d5c9;margin-top:24px;padding-top:18px;font-size:12px;font-weight:850}.drawer-foot small{display:block;font-size:10px;font-weight:500;color:#777;margin-top:3px}.drawer-foot-mark{width:12px;height:12px;background:var(--green);border:1.5px solid var(--ink);transform:rotate(45deg)}
/* Docs/profile/console */
#screen-profile,#screen-docs{padding-top:24px;gap:16px} #screen-profile .docs-header>.btn,#screen-docs .docs-header>.btn{display:none!important}.docs-header{position:static!important;top:auto!important;background:transparent!important;border-bottom:2px solid var(--ink)!important;padding:10px 0 18px!important;display:flex;align-items:center;justify-content:space-between}.docs-header .btn{width:auto!important}.docs-hero{border-radius:7px!important}.docs-mode{max-width:1440px!important}.console-fab{right:24px!important;bottom:105px!important;z-index:70!important;border-radius:7px!important}.console-drawer{border-radius:8px!important}.qris-result{color:var(--ink)!important}.qris-status-badge span{font-size:0}.qris-status-badge span:after{content:'';display:inline-block;width:7px;height:7px;background:currentColor;border-radius:50%}
@media(min-width:901px){#screen-dashboard{display:grid;grid-template-columns:minmax(0,1fr);gap:20px}.dashboard-intro{grid-column:1}.analytics-overview{grid-column:1}.token-card{grid-column:1;display:grid;grid-template-columns:1fr 1fr;gap:18px}.menu-tabs{position:fixed!important;left:50%!important;bottom:22px!important}.panel{grid-column:1}.qris-form{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:16px;align-items:start}.qris-form #qrisManualSection{grid-column:2;grid-row:1 / span 2}.qris-form #btnGenerateQris{grid-column:1;grid-row:2;align-self:end}.qris-result{display:grid;grid-template-columns:minmax(160px,260px) 1fr;align-items:center;gap:12px}.qris-result img{grid-row:span 4;max-width:100%}}
@media(max-width:900px){.app{padding:0 20px 118px!important}.header{margin:0 -20px!important;padding:12px 20px!important;min-height:72px}.landing-hero{grid-template-columns:1fr;gap:24px;min-height:0}.landing-copy h1{font-size:clamp(58px,13vw,88px)}.landing-art{min-height:340px;max-width:560px;width:100%;margin:0 auto}.art-bars{height:135px}.landing-section-head{align-items:start;flex-direction:column}.landing-section-head>p{max-width:600px}.feature-grid{grid-template-columns:1fr}.feature-card{min-height:180px}.feature-card>svg{margin-bottom:18px}.landing-cta{align-items:flex-start;flex-direction:column}.landing-cta .btn{width:100%}.analytics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.metric-card:last-child{grid-column:1/-1}.dashboard-intro{margin:0!important}.token-card{grid-template-columns:1fr!important}.menu-tabs{bottom:max(14px,env(safe-area-inset-bottom))!important;width:calc(100vw - 32px)!important;max-width:460px!important;justify-content:stretch}.menu-tab{flex:1;min-width:0!important;padding:0 7px!important;flex-direction:column;gap:4px;font-size:9px!important;min-height:52px!important}.screen{margin-top:0!important}.docs-header{top:auto!important}.chart-plot{height:145px}}
@media(max-width:520px){.app{padding-left:14px!important;padding-right:14px!important}.header{margin:0 -14px!important;padding:10px 14px!important;gap:9px;min-height:64px}.brand{font-size:15px!important;gap:7px!important}.brand-logo{width:34px!important;height:34px!important}.global-menu-btn,.profile-top-btn{width:37px!important;height:37px!important}.badge-connected{font-size:8px!important;padding:5px 7px!important}.header-actions{gap:6px!important}.landing-hero{padding-top:22px}.landing-copy h1{font-size:clamp(52px,15vw,72px);margin:20px 0}.landing-lead{font-size:14px}.landing-actions{display:grid;grid-template-columns:1fr}.landing-actions .btn{width:100%}.landing-art{min-height:290px}.art-main-card{padding:15px;width:84%}.art-bars{height:112px;gap:6px}.chip-top{right:-2px;top:8%}.chip-bottom{left:-2px;bottom:5%}.art-chip{padding:9px;font-size:8px}.art-chip svg{width:22px;height:22px}.landing-section-head h2{font-size:35px}.landing-cta h2{font-size:36px}.landing-footer{align-items:flex-start;flex-direction:column}.auth-card{padding:25px 20px!important}.analytics-grid{grid-template-columns:1fr 1fr;gap:9px}.metric-card{padding:13px}.metric-top{font-size:9px}.metric-top svg{width:19px;height:19px}.metric-card strong{font-size:23px}.metric-card small{font-size:9px}.chart-head{align-items:flex-start;flex-direction:column}.chart-note{font-size:9px}.chart-plot{grid-template-columns:28px minmax(0,1fr);height:125px}.chart-foot{font-size:8px}.analytics-live{font-size:8px;padding:7px}.dashboard-intro{padding:22px 18px!important}.dashboard-intro h1{font-size:42px!important}.dashboard-intro-stamp{width:60px!important;height:60px!important;flex-basis:60px!important}.token-btns{grid-template-columns:1fr 1fr!important}.menu-tabs{gap:2px!important;padding:5px!important;border-radius:15px!important}.menu-tab{min-height:49px!important;font-size:8px!important}.menu-tab svg{width:18px!important;height:18px!important}.console-fab{bottom:85px!important;right:14px!important}}
@media(prefers-reduced-motion:reduce){.art-main-card,.art-chip,.art-bars i{animation:none!important}.screen,.panel{animation:none!important}}

</style>
</head>
<body>
<div class="app" id="appRoot">
  <header class="header">
    <button class="icon-btn global-menu-btn" id="openDrawer" onclick="toggleNavDrawer(true)" aria-label="Buka menu navigasi" title="Menu"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    <div class="brand" onclick="showScreen(state.accessToken ? 'dashboard' : 'home')" role="button" tabindex="0" aria-label="GoMerchPro beranda">
      <div class="brand-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="#00d68f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
        </svg>
      </div>
      <span>GoMerch<em>Pro</em></span>
    </div>
    <div class="header-actions">
      <div id="headerBadge" class="header-actions" style="display:none">
      <button class="icon-btn" id="btnRefresh" onclick="refreshAll()" title="Refresh">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M23 4v6h-6M1 20v-6h6"/>
          <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
        </svg>
      </button>
      <div class="badge-connected"><span class="dot"></span> CONNECTED</div>
      </div>
      <button class="icon-btn profile-top-btn" id="profileTopBtn" onclick="showScreen('profile')" aria-label="Buka profil" title="Profile" style="display:none"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0 1 16 0v1"/></svg></button>
    </div>
  </header>

  <div class="nav-backdrop" id="navBackdrop" onclick="toggleNavDrawer(false)"></div>
  <aside class="nav-drawer" id="navDrawer" aria-hidden="true">
    <div class="drawer-head"><div><div class="eyebrow">WORKSPACE MENU</div><h2>Navigate.</h2></div><button class="icon-btn" onclick="toggleNavDrawer(false)" aria-label="Tutup menu"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
    <div class="drawer-section-label">WORKSPACE</div>
    <button class="drawer-link" data-screen="dashboard" onclick="navigateTo('dashboard')"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="8" height="8"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="11" width="7" height="10"/><rect x="3" y="14" width="8" height="7"/></svg><span>Dashboard</span><svg class="drawer-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
    <button class="drawer-link" data-screen="qris" onclick="navigateTo('qris')"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM19 14v7M14 19h3"/></svg><span>QRIS</span></button>
    <button class="drawer-link" data-screen="history" onclick="navigateTo('history')"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>Transaction history</span></button>
    <button class="drawer-link" data-screen="payouts" onclick="navigateTo('payouts')"><svg viewBox="0 0 24 24"><path d="M3 20h18M5 20V9h14v11M3 9l9-6 9 6M9 13v3m6-3v3"/></svg><span>Payouts</span></button>
    <div class="drawer-section-label">DEVELOPER</div>
    <button class="drawer-link" data-screen="docs" onclick="navigateTo('docs')"><svg viewBox="0 0 24 24"><path d="M5 3h10l4 4v14H5zM15 3v5h4M8 13h8M8 17h8"/></svg><span>Documentation API</span></button>
    <button class="drawer-link" onclick="toggleConsole(true);toggleNavDrawer(false)"><svg viewBox="0 0 24 24"><path d="m4 5 6 6-6 6M12 18h8"/></svg><span>API Console</span></button>
    <div class="drawer-section-label">ACCOUNT</div>
    <button class="drawer-link" data-screen="profile" onclick="navigateTo('profile')"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0 1 16 0v1"/></svg><span>Profile & Security</span></button>
    <button class="drawer-link drawer-logout" onclick="toggleNavDrawer(false);logout()"><svg viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"/></svg><span>Logout</span></button>
    <div class="drawer-foot"><span class="drawer-foot-mark"></span><span>GoMerchPro <small>Merchant workspace</small></span></div>
  </aside>

  <section id="screen-home" class="screen active">
    <div class="landing-hero">
      <div class="landing-copy">
        <div class="eyebrow"><span class="eyebrow-mark"></span> MERCHANT API WORKSPACE</div>
        <h1>Payment<br><span>in motion.</span></h1>
        <p class="landing-lead">Satu ruang kerja untuk menghubungkan GoPay Merchant, mengelola QRIS, dan memahami aktivitas transaksi melalui REST API.</p>
        <div class="landing-actions">
          <button class="btn btn-primary" onclick="showScreen('login')">Masuk ke workspace <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7"/></svg></button>
          <button class="btn btn-outline" onclick="showScreen('docs')">Jelajahi API Docs <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h8l4 4v14H7zM15 3v5h4M10 13h6M10 17h6"/></svg></button>
        </div>
        <div class="landing-proof"><span class="proof-icon"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg></span><span>Developer-first · Data-driven · Secure by design</span></div>
      </div>
      <div class="landing-art" aria-label="Ilustrasi dashboard pembayaran">
        <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
        <div class="art-chip chip-top"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM4 9h16M8 15h4"/></svg><span>MERCHANT<br><b>CONNECTED</b></span></div>
        <div class="art-main-card"><div class="art-card-head"><span>PAYMENT FLOW</span><svg viewBox="0 0 24 24"><path d="M4 17 9 11l4 3 7-8"/><path d="M15 6h5v5"/></svg></div><div class="art-bars"><i style="height:28%"></i><i style="height:44%"></i><i style="height:36%"></i><i style="height:62%"></i><i style="height:50%"></i><i style="height:82%"></i><i style="height:68%"></i><i style="height:100%"></i></div><div class="art-card-foot"><span>TRANSACTION ACTIVITY</span><b>LIVE VIEW</b></div></div>
        <div class="art-chip chip-bottom"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM19 14v7M14 19h3"/></svg><span>QRIS<br><b>READY TO BUILD</b></span></div>
      </div>
    </div>
    <div class="landing-section-head"><div><div class="eyebrow">ONE WORKSPACE</div><h2>Tools for every<br>payment workflow.</h2></div><p>Kelola alur penting melalui satu antarmuka yang dirancang untuk merchant dan developer.</p></div>
    <div class="feature-grid">
      <article class="feature-card feature-yellow"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM19 14v7M14 19h3"/></svg><span class="feature-index">01 / PAYMENTS</span><h3>QRIS workflows</h3><p>Buat dan periksa QRIS melalui alur yang tersedia di layanan.</p></article>
      <article class="feature-card feature-blue"><svg viewBox="0 0 24 24"><path d="M3 3v18h18M7 14l4-4 4 3 5-7"/></svg><span class="feature-index">02 / VISIBILITY</span><h3>Transaction insights</h3><p>Jelajahi data mutasi dan aktivitas tanpa mengarang statistik.</p></article>
      <article class="feature-card feature-green"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4zM8 9h8M8 13h5M8 17h3"/></svg><span class="feature-index">03 / DEVELOPERS</span><h3>API workspace</h3><p>Dokumentasi endpoint, contoh request, dan console pengujian.</p></article>
    </div>
    <div class="landing-cta"><div><div class="eyebrow">READY WHEN YOU ARE</div><h2>Make your next move.</h2><p>Masuk untuk membuka workspace merchant.</p></div><button class="btn btn-primary" onclick="showScreen('login')">Mulai sekarang <svg viewBox="0 0 24 24"><path d="M4 12h15M13 5l7 7-7 7"/></svg></button></div>
    <footer class="landing-footer"><span>GoMerchPro <span class="footer-dot"></span> Merchant API Workspace</span><button onclick="showScreen('docs')">Documentation <svg viewBox="0 0 24 24"><path d="M5 12h14M13 5l7 7-7 7"/></svg></button></footer>
  </section>

  <section id="screen-login" class="screen">
    <div class="auth-wrap">
      <div class="glass glass-strong auth-card">
        <h1>Merchant Access</h1>
        <p class="sub">Masuk ke dashboard GoBiz Merchant</p>
        <div>
          <label class="field-label">Nomor HP</label>
          <div class="phone-row">
            <span class="phone-prefix">+62</span>
            <input type="tel" id="phoneInput" placeholder="81234567890" inputmode="numeric" autocomplete="tel">
          </div>
        </div>
        <div style="margin-top:20px">
          <button class="btn btn-primary" id="btnLogin" onclick="requestOtp()">
            Lanjutkan
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
        <div class="error-msg" id="loginError"></div>
      </div>
    </div>
  </section>

  <section id="screen-otp" class="screen">
    <div class="auth-wrap">
      <div class="glass glass-strong auth-card">
        <div class="auth-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        </div>
        <h1>Verifikasi OTP</h1>
        <p class="sub">Kode dikirim ke <strong id="otpPhoneDisplay" style="color:var(--text)">+62</strong></p>
        <div class="otp-boxes" id="otpBoxes">
          <input type="text" maxlength="1" inputmode="numeric" data-idx="0" autocomplete="one-time-code">
          <input type="text" maxlength="1" inputmode="numeric" data-idx="1">
          <input type="text" maxlength="1" inputmode="numeric" data-idx="2">
          <input type="text" maxlength="1" inputmode="numeric" data-idx="3">
        </div>
        <p class="otp-hint">Tempel kode OTP, kolom akan terisi otomatis.</p>
        <button class="btn btn-purple" id="btnVerify" onclick="verifyOtp()">Verifikasi</button>
        <button class="btn btn-ghost" onclick="showScreen('login')">GANTI NOMOR HP</button>
        <div class="error-msg" id="otpError"></div>
      </div>
    </div>
  </section>

  <section id="screen-dashboard" class="screen">
