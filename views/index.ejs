    document.getElementById('qrisStatic').value = str;
    toast('QR berhasil terbaca ✅');
  } catch (err) {
    toast(err.message || 'Gagal decode QR');
  } finally {
    zone.classList.remove('loading');
    label.textContent = originalText;
  }
}

function handleQrFile(e) {
  const file = e.target.files?.[0];
  if (file) processQrFile(file);
  e.target.value = '';
}

async function generateQris() {
  const amount = document.getElementById('qrisAmount').value.trim();
  const staticQr = state.savedQris || document.getElementById('qrisStatic').value.trim();
  if (!amount) { toast('Isi nominal'); return; }
  if (!staticQr) { toast('QRIS belum diset — upload di Profile atau drop gambar'); return; }

  const btn = document.getElementById('btnGenerateQris');
  btn.disabled = true;
  btn.innerHTML = '<span class="loading-spinner"></span> Generating…';

  const res = await api('/gopay/qris/create', { amount, static_qr: staticQr });
  btn.disabled = false;
  btn.textContent = 'Generate QR';

  if (!res.ok || !res.data.success) {
    toast(typeof res.data.error === 'object' ? JSON.stringify(res.data.error) : (res.data.error || 'Gagal generate'));
    return;
