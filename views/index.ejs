.panel-title{font-size:clamp(20px,2vw,28px)!important;font-weight:850;letter-spacing:-.05em;margin-bottom:22px}
.field-label{font-size:11px!important;letter-spacing:.12em;font-weight:800!important;text-transform:uppercase;color:#444!important}
input,textarea,select{background:#fff!important;color:#171717!important;border:2px solid #191919!important;border-radius:4px!important;box-shadow:3px 3px 0 #191919!important;min-height:48px;font-family:inherit}
textarea{min-height:100px}input:focus,textarea:focus,select:focus{outline:3px solid #9bc8ff!important;outline-offset:2px}
